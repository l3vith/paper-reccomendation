# Semantic Scholar API Key (Optional - get your free key at https://www.semanticscholar.org/product/api)
# S2_API_KEY=your_key_here

# Hugging Face Token (Optional - for higher rate limits)
# HF_TOKEN=your_token_here

# Firecrawl API Key (Optional - research index works keyless with lower limits; get a key at https://www.firecrawl.dev/signin)
# FIRECRAWL_API_KEY=fc-your_key_here
